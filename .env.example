# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and customize values for your environment.
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# ==============================================================================
# Database Configuration & Mandatory Environment Separation
# ARCHITECTURE RULE: Localhost development and automated tests MUST use a local
# PostgreSQL instance. Development commands CANNOT connect to or silently fall
# back to production credentials.
# ==============================================================================
# Mandatory local development database:
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sell_digital_assets
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sell_digital_assets

# Isolated Production Cloud Database (Used ONLY when NODE_ENV=production):
# PROD_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_SSL=false

# Security & CORS
# Primary frontend client URL
CLIENT_URL=http://localhost:5173
# Comma-separated list of allowed origins (e.g., multiple local dev servers or frontends)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,http://localhost:5000
# Optional: Public URL of the backend API (required in production if serving local storage downloads)
# SERVER_URL=https://api.yourdomain.com

# Authentication & Signing Secrets (CRITICAL: Must be at least 32 characters long)
# Generate secure tokens in production with: openssl rand -hex 32
JWT_SECRET=development_super_secret_jwt_access_key_min_32_chars
JWT_REFRESH_SECRET=development_super_secret_jwt_refresh_key_min_32_chars

# Optional: Fallback Administrator Password for API documentation access (/doc)
# Default is synced dynamically with active Administrator accounts in PostgreSQL
# ADMIN_PASSWORD=P@ssw0rd

# Digital Asset Download Token Signing Key (Min 32 characters)
DOWNLOAD_TOKEN_SECRET=development_super_secret_download_signing_key_min_32_chars

# Server & Request Limits
BODY_LIMIT=10mb
EXPOSE_STACK=false

# Rate Limiting & Cache (Optional: Redis clustering support)
# REDIS_URL=redis://localhost:6379

# Storage Configuration
# Driver options: "local" (offline development) or "s3" / "r2" (cloud object storage)
STORAGE_DRIVER=local
# Local storage directory path (relative or absolute)
LOCAL_STORAGE_PATH=./storage
# Windows example: LOCAL_STORAGE_PATH=C:\GH\sell-digital-assets-storage

# S3-Compatible Cloud Storage Credentials (Required if STORAGE_DRIVER=s3 or r2)
AWS_REGION=ap-northeast-1
AWS_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
AWS_BUCKET_PRIVATE=sell-digital-assets-storage-private
AWS_BUCKET_PREVIEWS=sell-digital-assets-storage-previews
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# Supabase REST API & Storage Client (Optional / Dual-upload)
SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
