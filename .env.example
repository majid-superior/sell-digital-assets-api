PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/db

# Security & CORS (Only one URL allowed to hit the API, coming from .env)
# Set to http://localhost:5173 in development, or http://domain.com in production
CLIENT_URL=http://localhost:5173

# JWT Authentication Secrets (Use strong random strings in production)
JWT_SECRET=development_super_secret_jwt_access_key_min_32_chars
JWT_REFRESH_SECRET=development_super_secret_jwt_refresh_key_min_32_chars

# Digital Asset Download Token Signing Key
DOWNLOAD_TOKEN_SECRET=development_super_secret_download_signing_key_min_32_chars

# Request Limits & Debugging
BODY_LIMIT=10kb
EXPOSE_STACK=false

